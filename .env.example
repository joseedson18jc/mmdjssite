# Copie para .env (local) ou cole no painel do host: Netlify > Site settings > Environment variables.
# Nunca comite valores reais. A chave secreta so existe no servidor.

# Stripe — Developers > API keys
STRIPE_SECRET_KEY=sk_test_...

# Stripe — Developers > Webhooks > "Reveal signing secret" do endpoint /api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# Criados por `npm run stripe:seed`. Se ficarem vazios o checkout usa price_data
# (mesmo preco, montado no servidor) — funciona, so nao aparece no catalogo da Stripe.
STRIPE_PRICE_SINGLE=
STRIPE_PRICE_PACK=

# Meios de pagamento. Pix e boleto exigem conta Stripe brasileira cobrando em BRL.
STRIPE_ENABLE_PIX=true
STRIPE_ENABLE_BOLETO=false

# URL publica do site. Usada em success_url/cancel_url e nos links do e-mail.
SITE_URL=https://joseedson18jc.github.io/mmdjssite

# Opcional — entrega por e-mail depois do pagamento confirmado.
RESEND_API_KEY=
MAIL_FROM=Selo M & M <no-reply@seudominio.com>
